<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>wc3-inspect</AssemblyName>
    <RootNamespace>Wc3Inspect</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="War3Net.Build.Core" Version="6.0.3" />
    <PackageReference Include="War3Net.IO.Mpq" Version="6.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\version-catalog.json" Link="version-catalog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

